# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Public tracking ids only (they're in the page anyway); secrets never go here.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Claude Code settings
.claude/settings.local.json

# cloudflare / opennext
.open-next
.wrangler
.dev.vars*
!.dev.vars.example

# design references (local only, not part of the build)
/design_handoff_sweet_spot_site/
/mockups/

# raw source media dropped in the root (processed copies live in public/)
/*.mp4
/*.mov
